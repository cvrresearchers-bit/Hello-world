# Copy to .env and edit. Every key is optional; defaults are shown.
# Profile: smoke (seconds) | quick (a few minutes) | full (long, 30 seeds/cell)
NAA_PROFILE=quick
NAA_SEED=12345
# 0 = use all CPU cores
NAA_WORKERS=0
NAA_OUTPUT_DIR=output
NAA_LOG_LEVEL=INFO
# Run the pytest suite as the first stage of Main.py
NAA_RUN_TESTS=false
# Optional: path to tla2tools.jar to also run TLC on tla/AdaptiveAA.tla
NAA_TLC_JAR=
# Optional: path to the real Intel Berkeley Lab data.txt (else a surrogate is used)
NAA_INTEL_LAB_PATH=data/intel_lab/data.txt
